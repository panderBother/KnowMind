# 复制为 knowmind-server 目录下的 `.env`（勿提交 `.env`）

# MySQL 异步连接（应用运行时使用 asyncmy）

DATABASE_URL=mysql+asyncmy://knowmind:yourpassword@127.0.0.1:3306/knowmind



# JWT（生产务必改为随机长密钥）

JWT_SECRET=change-me-in-production



# 本地文件存储根（上传 PDF 等；后续可换 OSS 适配器）

STORAGE_LOCAL_ROOT=data/storage



# 向量：默认 Chroma 持久化目录（Windows 推荐）。远程 Milvus 示例：http://127.0.0.1:19530

# MILVUS_URI=http://127.0.0.1:19530

CHROMA_DATA_PATH=data/chroma

# 对话记忆向量（与文档 doc_chunks 分 collection；默认 chat_memory_bge_m3）

# CHROMA_CHAT_COLLECTION_NAME=chat_memory_bge_m3

WHOOSH_INDEX_ROOT=data/whoosh



# ---------- 方案 B：异步队列（Redis + Celery Worker）----------

REDIS_URL=redis://127.0.0.1:6379/0

CELERY_TASK_ALWAYS_EAGER=false

# 本机不想起 Redis/Celery Worker 时设为 true：上传后在 API 进程后台线程解析（开发用；生产请 false + Worker）
# INGEST_BACKGROUND_THREAD=true

# 无 Docker 时：自行安装并启动 Redis，监听 6379。

# 有 Docker 时（在 knowmind-server 目录）：

#   docker compose -f docker-compose.redis.yml up -d

# 然后另开终端启动 Worker（Windows 下代码已默认 solo 进程池，勿用 prefork，否则易句柄无效）：

#   uv run celery -A app.workers.celery_app.celery_app worker -l info

# 可选覆盖：CELERY_WORKER_POOL=threads

# API（uvicorn）与 Worker 需加载同一套 .env。



# ---------- 仅本地、不想起 Redis 时（与方案 B 二选一）----------

# CELERY_TASK_ALWAYS_EAGER=true

# ---------- EdgeFN 对话（OpenAI 兼容 /chat/completions）----------

# EDGEFN_API_KEY=

# EDGEFN_API_BASE_URL=https://api.edgefn.net/v1

# EDGEFN_CHAT_MODEL=DeepSeek-R1-0528-Qwen3-8B
# 成本统计：按供应商账单填写每百万 Token 美元单价；0 表示只统计 Token、不估价
# LLM_INPUT_COST_PER_MILLION_USD=0
# LLM_OUTPUT_COST_PER_MILLION_USD=0
# 识图勿用对话模型；留空则图片走 SILICONFLOW，不对 EdgeFN 发 image_url
# EDGEFN_VISION_MODEL=

# ---------- 硅基流动：图片/PDF OCR（DeepSeek-OCR，与对话独立）----------
# SILICONFLOW_API_KEY=
# SILICONFLOW_API_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_VISION_MODEL=deepseek-ai/DeepSeek-OCR

# 对外 HTTP：Windows 若开 Clash/VPN 代理易出现 SSL UNEXPECTED_EOF，请保持 false（直连 API）
# HTTP_TRUST_ENV=false
# HTTP_MAX_RETRIES=3

# ---------- Web 对话本地文件读写 ----------
# FILE_TOOLS_ENABLED=true
# EdgeFN 等未开 vLLM tool choice 时用 prompt（默认）；仅当网关明确支持 OpenAI tools 时用 native
# FILE_TOOLS_MODE=prompt
# 每位用户只能读写该根目录下自己的独立子目录；绝对路径也不能越出用户沙箱
# USER_WORKSPACE_ROOT=data/user_workspaces
# FILE_READ_MAX_BYTES=524288

# ---------- 联网搜索 MCP（Web Search）----------
# WEB_SEARCH_ENABLED=true
# 可选：Brave Search API（效果更好）https://brave.com/search/api/
# BRAVE_SEARCH_API_KEY=
# WEB_SEARCH_MAX_RESULTS=5
# FILE_TOOLS_MAX_ROUNDS=6

# ---------- 对话：远程 URL 型外部 MCP ----------
# EXTERNAL_MCP_ENABLED=true
# EXTERNAL_MCP_TOOL_MODE=prompt
# EXTERNAL_MCP_MAX_ROUNDS=4
# EXTERNAL_MCP_CONNECT_TIMEOUT=15
# EXTERNAL_MCP_READ_TIMEOUT=120
# 公网部署保持 false；command/stdio MCP 会直接执行本机进程
# EXTERNAL_MCP_STDIO_ENABLED=false

# ---------- 接口限流与每日请求额度（Redis 优先、内存降级）----------
# AUTH_RATE_LIMIT_PER_MINUTE=20
# CHAT_RATE_LIMIT_PER_MINUTE=20
# CHAT_DAILY_QUOTA=200
# UPLOAD_RATE_LIMIT_PER_MINUTE=20
# UPLOAD_DAILY_QUOTA=100
# 仅当 API 确实位于会覆盖 X-Forwarded-For 的可信反向代理后方时开启
# RATE_LIMIT_TRUST_PROXY_HEADERS=false

# ---------- 向量嵌入（默认 BGE-M3 + Chroma；pytest 用 hash）----------

# 首次启用 bge 会从 HuggingFace 拉取模型（体积较大）。Worker 与 API 需加载同一套 .env。
# 代码已默认 HF_HUB_DISABLE_XET=1（避免 Windows 上 XET 下载中断后缓存损坏）；若仍失败可手动删缓存目录：
#   %USERPROFILE%\.cache\huggingface\hub\models--BAAI--bge-m3

# EMBEDDING_MODE=bge

# ---------- 云端向量（白山智算 / EdgeFN 等 OpenAI 兼容 /v1/embeddings）----------
# 与本地二选一：设为 http 后无需本机 GPU、也不下载 bge 权重（适合文档入库与 RAG）
# EMBEDDING_MODE=http
# 可不填，默认沿用 EDGEFN_API_BASE_URL + EDGEFN_API_KEY（白山网关若不同再单独写）
# EMBEDDING_HTTP_BASE_URL=https://api.edgefn.net/v1
# EMBEDDING_HTTP_API_KEY=
# EMBEDDING_HTTP_MODEL=BAAI/bge-m3

# EMBEDDING_MODEL_ID=BAAI/bge-m3

# 离线 / 自行下载：把仓库拉到本地任意目录后，改为该路径（不要用在线 ID），例如：
#   hf download BAAI/bge-m3 --local-dir D:/models/bge-m3
# （旧命令 huggingface-cli 已弃用，请用 hf）
# 或浏览器打开 https://huggingface.co/BAAI/bge-m3 下载全部文件到同一文件夹，然后：
# EMBEDDING_MODEL_ID=D:/models/bge-m3

# EMBEDDING_VECTOR_DIM=1024（须与所选模型 dense 维数一致；Milvus 建集后勿随意改）

# 若曾使用旧版伪向量：请清空 CHROMA_DATA_PATH 或换新 CHROMA_COLLECTION_NAME，避免维数不一致。

# CHROMA_COLLECTION_NAME=doc_chunks_bge_m3

# MILVUS_COLLECTION_NAME=scholar_doc_chunks_bge_m3

# RAG_TOP_K=8
# RAG_VECTOR_TOP_K=15
# RAG_BM25_TOP_K=20
# RAG_CANDIDATE_K=32
# 入库语义切块（字符）
# CHUNK_MIN_CHARS=120
# CHUNK_MAX_CHARS=640
# CHUNK_OVERLAP=100
# token 级切块目标（字符参数仍作为兼容的硬上限）
# CHUNK_TARGET_TOKENS=360
# CHUNK_MAX_TOKENS=560
# CHUNK_OVERLAP_TOKENS=64
# 管理端搜索 / 对话：语义分门槛（对话默认更严 0.5）
# RAG_MIN_RELEVANCE_SCORE=0.45
# RAG_CHAT_MIN_RELEVANCE_SCORE=0.5
# 对话 RAG 默认开启 Rerank 精排后再决定是否引用；true=跳过（更快但易误引）
# RAG_CHAT_SKIP_RERANK=false

# ---------- 混合检索 Rerank（BGE-Reranker）----------
# 对话与管理端搜索共用：Chroma 向量 + Whoosh BM25 → RRF → Rerank
# RERANK_ENABLED=true
# 默认 http：白山智算 / EdgeFN POST /v1/rerank，无需本地下载 reranker 权重
# RERANK_MODE=http
# 可不填，默认沿用 EDGEFN_API_BASE_URL + EDGEFN_API_KEY（与嵌入共用）
# RERANK_HTTP_BASE_URL=https://api.edgefn.net/v1
# RERANK_HTTP_API_KEY=
# RERANK_HTTP_MODEL=bge-reranker-v2-m3
# 本机 CrossEncoder（需下载 HuggingFace 权重）：
# RERANK_MODE=local
# RERANK_MODEL_ID=BAAI/bge-reranker-v2-m3
# ---------- Skill / MCP 导出 ----------
# 对外 API 基址（Cursor MCP 回调用；未设则从请求推断）
# PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
# knowmind-mcp 目录（生成 mcp.json 中 --directory 路径）
# KNOWMIND_MCP_ROOT=D:/KnowMind/knowmind-mcp

# ---------- JWT Refresh ----------
# REFRESH_TOKEN_EXPIRE_DAYS=30

# ---------- 学术检索 MCP（arXiv / Semantic Scholar）----------
# ARXIV_ENABLED=true
# ARXIV_MAX_RESULTS=5
# SEMANTIC_SCHOLAR_ENABLED=true
# SEMANTIC_SCHOLAR_MAX_RESULTS=5

# ---------- 对话附件（按用户隔离并随消息保留元数据）----------
# CHAT_ATTACHMENT_ROOT=data/chat_attachments
# CHAT_ATTACHMENT_MAX_MB=10

# ---------- 评估流水线 ----------
# EVAL_REPORTS_DIR=../knowmind-eval/reports
# EVAL_AUTO_BOOTSTRAP=true
